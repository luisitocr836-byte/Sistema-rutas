# Copiar a backend/.env (ver ../.env.example). Contiene SECRETOS: no subir al repositorio.
# ---------------------------------------------------------------------
# SERVIDOR (backend/.env) — SECRETOS: nunca en el repositorio ni en la app
# ---------------------------------------------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Settings → API → service_role (omite RLS). Solo en un equipo/servidor de confianza.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# Proveedor de ruteo vial para el ETA: osrm | google | none (none = solo respaldo por trazado)
ETA_PROVIDER=osrm
# El servidor público de OSRM es SOLO de demostración; para validación use una instancia propia.
OSRM_BASE_URL=https://router.project-osrm.org
# Solo si ETA_PROVIDER=google (Distance Matrix API)
GOOGLE_MAPS_API_KEY=

# Parámetros del motor ETA (valores iniciales SIN CALIBRAR; ajústelos con el MAE de campo)
ETA_TIMEOUT_PROVEEDOR_MS=4000
ETA_INTERVALO_MINIMO_S=5
ETA_LECTURAS_SUAVIZADO=8
ETA_PESO_PROVEEDOR=0.6
ETA_VELOCIDAD_RESPALDO_KMH=15
ETA_VELOCIDAD_REFERENCIA_KMH=30
ETA_RADIO_LLEGADA_M=40
ETA_EDAD_MAXIMA_S=60
